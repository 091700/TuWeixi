<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 AppCompat 命名空间：xmlns:app="http://schemas.android.com/apk/res-auto" -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:paddingBottom="32dp"
    android:background="@color/gray_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加新任务"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/gray_900"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_task_name"
            android:background="@drawable/edittext_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="16sp"
            app:hintTextColor="@color/gray_500"
        android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spTaskType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/task_types"
            android:background="@drawable/edittext_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:dropDownVerticalOffset="4dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_select_date"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btnSelectTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_select_time"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_location"
            android:background="@drawable/edittext_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="16sp"
            app:hintTextColor="@color/gray_500"
        android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAssociateLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_associate_location"
            android:background="@drawable/button_yellow_bg"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_take_photo" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已拍凭证照片：0 张"
                android:textSize="14sp"
                android:textColor="@color/gray_700"
                android:layout_marginLeft="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优先级"
                android:textSize="16sp"
                android:textColor="@color/gray_900"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rb_high"
                    android:textSize="16sp"
                    android:buttonTint="@color/yellow_400"
                    android:layout_marginRight="24dp" />

                <RadioButton
                    android:id="@+id/rbMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rb_medium"
                    android:checked="true"
                    android:textSize="16sp"
                    android:buttonTint="@color/yellow_400"
                    android:layout_marginRight="24dp" />

                <RadioButton
                    android:id="@+id/rbLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rb_low"
                    android:textSize="16sp"
                    android:buttonTint="@color/yellow_400" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_task"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>