<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Campustaskmanager" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/gray_100</item>
        <item name="android:textColorPrimary">@color/gray_900</item>
        <item name="android:textColorSecondary">@color/gray_700</item>
        <item name="android:buttonStyle">@style/CustomButtonStyle</item>
    </style>

    <style name="CustomButtonStyle" parent="Widget.AppCompat.Button">
        <item name="android:radius">4dp</item>
        <item name="android:background">@drawable/button_yellow_bg</item>
        <item name="android:textColor">@color/gray_900</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="Theme.Campustaskmanager" parent="Base.Theme.Campustaskmanager" />
</resources>