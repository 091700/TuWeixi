# ══════════════════════════════════════════════════════
# 数据库 AI Agent — 环境变量模板
# 复制此文件为 .env 并填入真实值
# ══════════════════════════════════════════════════════

# LLM API 配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 目标数据库（生产环境请使用只读账号）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agent_readonly
MYSQL_PASSWORD=your-readonly-password
MYSQL_DATABASE=test_db

# 管理员写操作使用的独立账号（可选，不设则使用 MYSQL_USER）
MYSQL_ADMIN_USER=agent_admin
MYSQL_ADMIN_PASSWORD=your-admin-password

# JWT 密钥（必填！至少32位随机字符串）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# 元数据缓存 TTL（秒）
METADATA_CACHE_TTL=300

# ChromaDB 持久化路径
CHROMA_PERSIST_PATH=./chroma_data

# Embedding 模型
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# 认证数据库
AUTH_MYSQL_DATABASE=agent_auth

# 安全限制
QUERY_TIMEOUT=10
RESULT_ROW_LIMIT=100
RESULT_ROW_MAX=500
SESSION_TTL=1800
SESSION_MAX_MESSAGES=20

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 速率限制
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute